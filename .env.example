BETTER_AUTH_SECRET=generate-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
ROOT_DOMAIN=localhost
DATABASE_URL=postgres://appbuilder:CHANGE_ME@localhost:5432/appbuilder
TEST_DATABASE_URL=postgres://appbuilder:CHANGE_ME@localhost:5432/appbuilder_test

# Dev/demo tools: test credits, simulated checkout, unit economics (NEVER on a real production server)
ENABLE_DEV_TOOLS=true
# AI_PROVIDER=mock (no API key needed) | anthropic (Claude)
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5   # or claude-sonnet-5-5
# PAYMENT_PROVIDER=dev (simulated checkout, needs ENABLE_DEV_TOOLS) | stripe
PAYMENT_PROVIDER=dev
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...      # signing secret of https://<platform>/api/stripe/webhook
# Free AI previews (first site free): global caps per 24 h, 0 = off
# FREE_PREVIEW_DAILY_LIMIT=200
# FREE_PREVIEW_DAILY_BUDGET_USD=25
# Reverse proxies in front of the app (client IP for abuse limits); 0 = none
# TRUST_PROXY_HOPS=1
# Simulated AI latency in ms (mock provider only)
# MOCK_AI_LATENCY_MS=900
# Uploaded images: MEDIA_STORAGE=local (files in MEDIA_DIR) | s3 (not implemented yet)
MEDIA_STORAGE=local
# MEDIA_DIR=./data/uploads
