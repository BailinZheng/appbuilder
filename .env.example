BETTER_AUTH_SECRET=generate-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
ROOT_DOMAIN=localhost
DATABASE_URL=postgres://appbuilder:CHANGE_ME@localhost:5432/appbuilder
TEST_DATABASE_URL=postgres://appbuilder:CHANGE_ME@localhost:5432/appbuilder_test

# Dev/demo tools: test credits, simulated checkout, unit economics (NEVER on a real production server)
ENABLE_DEV_TOOLS=true
# AI_PROVIDER=mock | anthropic (not implemented yet)
AI_PROVIDER=mock
# PAYMENT_PROVIDER=dev | stripe (not implemented yet)
PAYMENT_PROVIDER=dev
# Simulated AI latency in ms (mock provider only)
# MOCK_AI_LATENCY_MS=900
# Uploaded images: MEDIA_STORAGE=local (files in MEDIA_DIR) | s3 (not implemented yet)
MEDIA_STORAGE=local
# MEDIA_DIR=./data/uploads
